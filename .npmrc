# pnpm 11 defaults strictDepBuilds to true, which fails the entire install if any
# dependency's build script is skipped. Cendoris needs none of them at build time
# (verified: a full `next build` succeeds with --ignore-scripts), and the native
# ones - keccak, secp256k1 - are hardhat-only and never used by the web app.
# Downgrade the skip from a hard error back to a warning.
strict-dep-builds=false
